<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="project_projx.xsd">
  <SchemaVersion>2.1</SchemaVersion>
  <Header>### uVision Project, (C) Keil Software</Header>
  <Targets>
    <Target>
      <TargetName>GD32F303RET6_SafeInitial</TargetName>
      <ToolsetNumber>0x4</ToolsetNumber>
      <ToolsetName>ARM-ADS</ToolsetName>
      <pCCUsed>6160000::V6.16::ARMCLANG</pCCUsed>
      <TargetOption>
        <TargetCommonOption>
          <Device>GD32F303RET6</Device>
          <Vendor>GigaDevice</Vendor>
          <PackID>GigaDevice.GD32F30x_DFP.2.6.0</PackID>
          <Cpu>IRAM(0x20000000-0x2000FFFF) IROM(0x08000000-0x0807FFFF) CLOCK(8000000) CPUTYPE("Cortex-M4")</Cpu>
          <OutputDirectory>.\Objects\</OutputDirectory>
          <OutputName>OBC_1p5KW_Initial</OutputName>
          <CreateExecutable>1</CreateExecutable>
          <CreateHexFile>1</CreateHexFile>
          <DebugInformation>1</DebugInformation>
          <BrowseInformation>1</BrowseInformation>
        </TargetCommonOption>
        <CommonProperty>
          <UseCPPCompiler>0</UseCPPCompiler>
          <RVCTCodeConst>0</RVCTCodeConst>
          <RVCTZI>0</RVCTZI>
          <RVCTOtherData>0</RVCTOtherData>
          <ModuleSelection>0</ModuleSelection>
        </CommonProperty>
        <DllOption>
          <SimDllName>SARMCM3.DLL</SimDllName>
          <SimDlgDll>DCM.DLL</SimDlgDll>
          <TargetDllName>SARMCM3.DLL</TargetDllName>
          <TargetDlgDll>TCM.DLL</TargetDlgDll>
        </DllOption>
        <TargetArmAds>
          <ArmAdsMisc>
            <GenerateListings>1</GenerateListings>
            <asHll>1</asHll>
            <asAsm>1</asAsm>
            <asMacX>1</asMacX>
            <asSyms>1</asSyms>
            <asFals>1</asFals>
            <asDbgD>1</asDbgD>
            <asForm>1</asForm>
            <ldMap>1</ldMap>
            <ldXref>1</ldXref>
            <ldCallGraph>1</ldCallGraph>
            <ldSymbols>1</ldSymbols>
            <ldInfo>1</ldInfo>
          </ArmAdsMisc>
          <Cads>
            <interw>1</interw>
            <Optim>2</Optim>
            <oTime>0</oTime>
            <SplitLS>0</SplitLS>
            <OneElfS>1</OneElfS>
            <Strict>1</Strict>
            <wLevel>2</wLevel>
            <uThumb>0</uThumb>
            <VariousControls>
              <MiscControls>-std=c11</MiscControls>
              <Define></Define>
              <Undefine></Undefine>
              <IncludePath>..\..\..\include;..\baremetal</IncludePath>
            </VariousControls>
          </Cads>
          <LDads>
            <umfTarg>1</umfTarg>
            <Ropi>0</Ropi>
            <Rwpi>0</Rwpi>
            <noStLib>0</noStLib>
            <RepFail>1</RepFail>
            <UseScatter>1</UseScatter>
            <ScatterFile>..\baremetal\gd32f303re.sct</ScatterFile>
          </LDads>
        </TargetArmAds>
      </TargetOption>
      <Groups>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File><FileName>main.c</FileName><FileType>1</FileType><FilePath>..\..\..\src\main.c</FilePath></File>
            <File><FileName>app.c</FileName><FileType>1</FileType><FilePath>..\..\..\src\app.c</FilePath></File>
            <File><FileName>can_service.c</FileName><FileType>1</FileType><FilePath>..\..\..\src\can_service.c</FilePath></File>
            <File><FileName>safety_manager.c</FileName><FileType>1</FileType><FilePath>..\..\..\src\safety_manager.c</FilePath></File>
          </Files>
        </Group>
        <Group>
          <GroupName>GD32F303 Bare Metal</GroupName>
          <Files>
            <File><FileName>board_baremetal.c</FileName><FileType>1</FileType><FilePath>..\baremetal\board_baremetal.c</FilePath></File>
            <File><FileName>system_gd32f303.c</FileName><FileType>1</FileType><FilePath>..\baremetal\system_gd32f303.c</FilePath></File>
            <File><FileName>startup_gd32f303.c</FileName><FileType>1</FileType><FilePath>..\baremetal\startup_gd32f303.c</FilePath></File>
          </Files>
        </Group>
      </Groups>
    </Target>
  </Targets>
</Project>
